; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="World"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.42795888, 0.5753326, 1, 1)
config/icon="res://icon.svg"

[autoload]

GameMode="*res://scripts/game_mode.gd"
NetworkManager="*res://scripts/network_manager.gd"
SaveManager="*res://scripts/save_manager.gd"

[compression]

formats/zstd/long_distance_matching=true
formats/zlib/compression_level=9
formats/gzip/compression_level=9

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1600
window/size/window_height_override=1200
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/per_pixel_transparency/allowed=true

[editor]

export/convert_text_resources_to_binary=false
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[gdunit4]

settings/common/update_notification_enabled=false

[input]

use={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":70,"key_label":0,"unicode":102,"location":0,"echo":false,"script":null)
]
}

[physics]

2d/run_on_separate_thread=true
3d/physics_engine="Dummy"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/lossless_compression/force_png=true
viewport/hdr_2d=true
anti_aliasing/screen_space_roughness_limiter/enabled=false
viewport/transparent_background=true
