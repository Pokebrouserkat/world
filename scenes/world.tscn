[sub_resource type="Shader" id="Shader_roof"]
code = "shader_type canvas_item;
uniform vec2 player_pos;
uniform float reveal_radius = 24.0;
uniform float fade_width = 16.0;
uniform bool enabled = false;

varying vec2 world_pos;

void vertex() {
	world_pos = (MODEL_MATRIX * vec4(VERTEX, 0.0, 1.0)).xy;
}

void fragment() {
	vec4 tex = texture(TEXTURE, UV);
	if (!enabled) {
		COLOR = tex;
	} else {
		float dist = distance(world_pos, player_pos);
		float alpha = smoothstep(reveal_radius, reveal_radius + fade_width, dist);
		COLOR = vec4(tex.rgb, tex.a * alpha);
	}
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_roof"]
shader = SubResource("Shader_roof")
shader_parameter/player_pos = Vector2(0, 0)
shader_parameter/reveal_radius = 24.0
shader_parameter/fade_width = 16.0
shader_parameter/enabled = false

